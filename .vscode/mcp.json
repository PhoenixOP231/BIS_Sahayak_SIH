{
  "servers": {
    "21st": {
      "type": "http",
      "url": "https://21st.dev/api/mcp",
      "headers": {
        "x-api-key": "${input:21st-api-key}"
      }
    }
  },
  "inputs": [
    {
      "type": "promptString",
      "id": "21st-api-key",
      "description": "21st API key (https://21st.dev/settings/api-keys)",
      "password": true
    }
  ]
}
